{
  "functions": {
    "api/analyze.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|src/|node_modules/|@vite/|@react-refresh|@id/|.*\\.(?:js|jsx|ts|tsx|css|svg|png|jpg|jpeg|gif|webp|ico|woff|woff2|ttf|otf|json|map|html)).*)",
      "destination": "/index.html"
    }
  ]
}